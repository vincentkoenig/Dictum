# Vorlage für die lokale Konfiguration der Desktop-App.
# Kopieren nach ".env" und eigene Werte eintragen.
# Die echte .env steht in .gitignore und landet NIE auf GitHub.

# --- KI-Anbieter ---
# Welcher Anbieter bereinigt Diktate und fasst Gespräche zusammen: "anthropic" oder "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Spracherkennung ---
# "local" = faster-whisper auf diesem PC, "openai" = Cloud-API
TRANSCRIBE_MODE=local

# --- Supabase (ab Phase 3) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
