# Vorlage für geheime Schlüssel. Kopieren nach ".env" (gleicher Ordner) und eintragen.
# Die echte .env steht in .gitignore und landet NIE auf GitHub.
#
# Alle anderen Einstellungen (welcher Anbieter, welches Modell …) stehen in
# desktop/settings.toml – dort ist nichts geheim.

# Claude – https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# OpenAI (optional) – https://platform.openai.com/api-keys
# Nötig für Cloud-Transkription oder wenn OpenAI statt Claude bereinigen soll.
OPENAI_API_KEY=

# --- Dictum-Konto in Supabase (ab Phase 3) ---
# Das Konto legst du im Supabase-Dashboard an (Authentication → Users → Add user).
# URL und öffentlicher Schlüssel des Projekts stehen in desktop/settings.toml.
DICTUM_EMAIL=
DICTUM_PASSWORD=
